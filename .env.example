# J.A.R.V.I.S. 20 — tudo gratuito, sem cartão.
# Nunca coloque estas variáveis com prefixo VITE_ (isso as expõe no navegador).
# Várias chaves separadas por vírgula são aceitas (o servidor alterna entre elas).

# ---- Cérebro (obrigatório: pelo menos UM destes) ----
GROQ_API_KEYS=
GEMINI_API_KEYS=
JARVIS_PROVIDER_ORDER=gemini,groq

# Modelos (opcional; deixe em branco para usar os padrões)
GROQ_MODELS=
GEMINI_MODELS=

# ---- Pesquisa web ----
# Funciona SEM nenhuma chave: Wikipedia + DuckDuckGo + notícias (RSS) + APIs públicas.
# Se tiver chave do Gemini acima, ela também é usada para o Google Search grounding.
# Opcionais, só se a pesquisa sem chave estiver falhando no seu deploy (planos gratuitos):
TAVILY_API_KEY=
BRAVE_API_KEY=
# GEMINI_SEARCH_API_KEYS=   (pool separado de chaves só para pesquisa)
# GEMINI_SEARCH_MODELS=     (modelos com Google Search grounding na sua conta)

VITE_TTS_ENGINE=system
